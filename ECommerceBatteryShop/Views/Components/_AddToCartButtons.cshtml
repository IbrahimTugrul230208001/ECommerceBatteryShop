@model ECommerceBatteryShop.Models.ProductViewModel
@{
    var inStock = Model.StockQuantity > 0;
    var dynamicQty = ViewData["DynamicQuantity"] as bool? ?? false;
    var buttonClass = ViewData["ButtonClass"]?.ToString() ?? "h-9 w-full rounded-sm text-sm font-semibold shadow transition-colors duration-300 relative overflow-hidden focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-400 cursor-pointer disabled:cursor-not-allowed p-0";
    var outOfStockClass = ViewData["OutOfStockClass"]?.ToString() ?? "h-9 w-full rounded-md bg-gray-300 text-sm font-semibold text-gray-500 shadow cursor-not-allowed";
    var normalClass = ViewData["NormalClass"]?.ToString() ?? "bg-slate-100 text-gray-900 hover:bg-slate-200";
    var loadingClass = ViewData["LoadingClass"]?.ToString() ?? "bg-slate-100 text-gray-500";
    var successClass = ViewData["SuccessClass"]?.ToString() ?? "text-green-500 bg-slate-100";
    var svgClass = ViewData["SvgColor"]?.ToString() ?? "h-5 w-5 text-gray-900";
}

@if (inStock)
{
    <button
        hx-post="/Sepet/Add"
        @(dynamicQty ? Html.Raw($":hx-vals=\"JSON.stringify({{ productId: {Model.Id}, quantity: qty }})\"") : Html.Raw($"hx-vals='{{\"productId\": {Model.Id}, \"quantity\": 1}}'"))
        hx-swap="none"
        hx-on::before-request="this._alpine.loading = true"
        hx-on::after-request="this._alpine.loading = false; this._alpine.added = true; setTimeout(() => this._alpine.added = false, 1600)"
        x-data="{ loading: false, added: false }"
        x-init="$el._alpine = $data"
        :class="added ? '@successClass' : (loading ? '@loadingClass' : '@normalClass')"
        :disabled="loading || added"
        class="@buttonClass">
        <!-- Normal state -->
        <span x-cloak x-show="!loading && !added" class="flex items-center justify-center gap-1.5">
            <svg class="@svgClass" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <path d="M21 5L19 12H7.37671M20 16H8L6 3H3M16 5.5H13.5M13.5 5.5H11M13.5 5.5V8M13.5 5.5V3M9 20C9 20.5523 8.55228 21 8 21C7.44772 21 7 20.5523 7 20C7 19.4477 7.44772 19 8 19C8.55228 19 9 19.4477 9 20ZM20 20C20 20.5523 19.5523 21 19 21C18.4477 21 18 20.5523 18 20C18 19.4477 18.4477 19 19 19C19.5523 19 20 19.4477 20 20Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path> </g></svg>                                                
            <span>Sepete ekle</span>
        </span>

        <!-- Loading state -->
        <span x-cloak x-show="loading" class="absolute inset-0 flex items-center justify-center gap-2">
            <svg class="animate-spin h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-30" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
            </svg>
            <span>Ekleniyor...</span>
        </span>

        <!-- Success state -->
        <span x-cloak x-show="added" class="absolute inset-0 flex items-center justify-center gap-1">
            <span>Sepete eklendi</span>
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5" /></svg> 
        </span>
    </button>
}
else
{
    <button type="button"
            disabled
            class="@outOfStockClass">
        Stokta yok
    </button>
}
