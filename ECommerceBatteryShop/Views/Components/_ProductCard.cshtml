@model ECommerceBatteryShop.Models.ProductViewModel
@{
    var href = $"/{Model.Slug}";
}

<article
    class="group relative h-[26rem] flex flex-col rounded-md border border-slate-200 hover:border-slate-300 bg-white shadow-sm transition hover:shadow-md">

    <!-- Favorite Button (top-right overlay) -->
    @await Html.PartialAsync("~/Views/Components/_FavoriteButton.cshtml", Model)

    <!-- Image -->
    <a href="@href" class="block p-3 pb-0">
        <div class="h-56 grid place-items-center overflow-hidden">
            <img src="/img/@(string.IsNullOrWhiteSpace(Model.ImageUrl) ? "temsili.webp" : Model.ImageUrl)"
                alt="@(string.IsNullOrWhiteSpace(Model.Name) ? "Görsel yok" : Model.Name)"
                class="h-56 w-auto object-contain transition-transform duration-200" />
        </div>
    </a>

    <!-- Shipping Badge -->
    <div class="mt-2 bg-amber-400 flex items-center justify-center gap-1.5 px-2.5 py-0.5 text-gray-900 shadow-sm">
        <svg class="w-5 h-5 flex-shrink-0" viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg" fill="currentColor">
            <g>
                <path
                    d="M37.7,11.1A3,3,0,0,0,35.4,10H34.2l.3-1.7A3.1,3.1,0,0,0,33.9,6a3.2,3.2,0,0,0-2.2-1H7.8a2,2,0,0,0,0,4H30.3l-4,22.9a6.8,6.8,0,0,0-1,2.1H20.7A7,7,0,0,0,7.3,34H6.2l.5-2.9a2,2,0,0,0-1.6-2.3,2,2,0,0,0-2.3,1.6L2,34.7A2.8,2.8,0,0,0,2.7,37a2.8,2.8,0,0,0,2.1,1H7.3a7,7,0,0,0,13.4,0h4.6a7,7,0,0,0,13.4,0h2a3.2,3.2,0,0,0,3.1-2.7L46,22.5ZM14,39a3,3,0,0,1-3-3,3,3,0,0,1,6,0A3,3,0,0,1,14,39ZM33.5,14h1.3l5.9,8H32.1ZM32,39a3,3,0,0,1-3-3,3,3,0,0,1,6,0A3,3,0,0,1,32,39Zm8-5H38.7A7,7,0,0,0,32,29H30.9l.5-3.1h9.9Z" />
                <path d="M4,15H14a2,2,0,0,0,0-4H4a2,2,0,0,0,0,4Z" />
                <path d="M15,19a2,2,0,0,0-2-2H5a2,2,0,0,0,0,4h8A2,2,0,0,0,15,19Z" />
                <path d="M6,23a2,2,0,0,0,0,4h6a2,2,0,0,0,0-4Z" />
            </g>
        </svg>
        <span class="text-xs font-semibold tracking-wide">24 saatte kargoda</span>
    </div>

    <!-- Content -->
    <div class="flex-1 flex flex-col px-2 py-1 mt-2">
        <a class="hover:underline" href="@href">
            <h3 class="text-sm text-gray-700 line-clamp-2 min-h-[2.75rem]">@Model.Name</h3>
        </a>

        <!-- Rating + Price -->
        <div class="mt-1 flex items-center justify-between">
            <div class="text-right w-full">
                @await Html.PartialAsync("~/Views/Components/_PriceTag.cshtml", Model)
            </div>
        </div>
    </div>

    <!-- Actions -->
    <div class="mt-3 mb-3 flex items-center gap-2 sm:py-0">
        <div class="flex flex-1 flex-col gap-1 py-2 px-1">
            @await Html.PartialAsync("~/Views/Components/_AddToCartButtons.cshtml", Model)
        </div>
    </div>
</article>
