@*
    One-shot banners carried across a redirect via TempData["SuccessMessage"] / TempData["ErrorMessage"].
    Include at the top of a view; renders nothing when both are absent.
*@

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div role="status" aria-live="polite"
         class="mb-5 flex items-start gap-3 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3
                text-sm font-medium text-emerald-800 shadow-sm">
        <svg class="mt-0.5 h-5 w-5 flex-none text-emerald-500" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="12" cy="12" r="9" />
            <path stroke-linecap="round" stroke-linejoin="round" d="m8.5 12.25 2.5 2.5 4.5-5" />
        </svg>
        <span>@successMessage</span>
    </div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div role="alert" aria-live="assertive"
         class="mb-5 flex items-start gap-3 rounded-xl border border-red-200 bg-red-50 px-4 py-3
                text-sm font-medium text-red-800 shadow-sm">
        <svg class="mt-0.5 h-5 w-5 flex-none text-red-500" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="12" cy="12" r="9" />
            <path stroke-linecap="round" d="M12 7.75v4.75" />
            <path stroke-linecap="round" d="M12 16.25h.01" />
        </svg>
        <span>@errorMessage</span>
    </div>
}
