@using System.Globalization
@model IEnumerable<ECommerceBatteryShop.Models.ProductSectionViewModel>

<section class="mb-8 -mt-4"
         x-data="heroCarousel()"
         x-init="init($el)"
         @@keydown.window.arrow-left.prevent="prev()"
         @@keydown.window.arrow-right.prevent="next()">
    <div class="relative overflow-hidden bg-gray-900 text-white h-[50vh] sm:h-[36vh] md:h-[55vh] lg:h-[86vh] -mx-2 lg:-mx-8">
        <!-- Slides -->
        <template x-for="(slide, i) in slides" :key="i">
            <div class="absolute inset-0 transition-opacity duration-700"
                 :class="current===i ? 'opacity-100 z-10' : 'opacity-0 z-0'"
                 role="group"
                 :aria-roledescription="'slide ' + (i+1) + ' of ' + slides.length">

            
         
                <template x-if="slide.mobileSrc">
                    <img :src="slide.mobileSrc" :alt="slide.alt"
                         class="block sm:hidden w-full h-full object-cover opacity-90" loading="lazy" />
                </template>
                <!-- Fallback for mobile if no mobileSrc -->
                <template x-if="!slide.mobileSrc">
                    <img :src="slide.src" :alt="slide.alt"
                         class="block sm:hidden w-full h-full object-cover opacity-90" loading="lazy" />
                </template>

                <!-- Desktop / tablet -->
                <img :src="slide.src" :alt="slide.alt"
                     class="hidden sm:block w-full h-full object-cover opacity-90" loading="lazy" />

                <!-- Hero text overlay -->
                <div class="absolute inset-0 z-20 flex items-center">
                    <!-- Gradient: full-height left side on all breakpoints -->
                    <div class="w-[70%] sm:w-auto sm:max-w-[55%] lg:max-w-[48%]
                                h-full
                                bg-gradient-to-r from-gray-900/95 via-gray-900/75 to-transparent
                                px-10 lg:px-16
                                flex flex-col justify-center gap-2 sm:gap-5">

                        <!-- Title -->
                        <h1 class="text-md sm:text-lg md:text-2xl lg:text-3xl font-extrabold leading-snug tracking-tight text-white drop-shadow-lg">
                            BATARYA PAKETLERİ İÇİN HEMEN TEKLİF ALIN ⚡
                        </h1>

                        <!-- Description -->
                        <p class="text-[10px] sm:text-xs md:text-sm lg:text-base text-gray-200 leading-relaxed max-w-xl">
                            Endüstriyel sistemlerden giyilebilir teknolojilere kadar tüm projelerinizde yüksek kaliteli batarya çözümleri sunuyoruz. Size özel tasarım ve teknik planlama desteği için bizimle iletişime geçin.
                        </p>
                    <div class="flex flex-row justify-start items-center gap-2 sm:gap-5">
                        <!-- CTA Button -->
                        <template x-if="slide.btnText">
                            <div class="sm:pt-2">
                                <a :href="slide.btnLink || 'https://api.whatsapp.com/send/?phone=905013176653'"
                                   class="btn-shine inline-flex items-center gap-1.5 sm:gap-2.5
                                          px-5 py-3 sm:px-8 lg:py-4
                                          bg-amber-400 hover:bg-amber-500 text-gray-900
                                          font-bold text-xs sm:text-base
                                          rounded-full shadow-2xl
                                          transition-all duration-300 ease-out
                                          hover:shadow-amber-500/40 hover:shadow-xl
                                          hover:bg-amber-600
                                          ring-2 ring-amber/25
                                          whitespace-nowrap">

                                   <svg class="w-4 h-4 sm:w-6 sm:h-6" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g>
                                        <g id="SVGRepo_iconCarrier">
                                            <path d="M21 7V3M21 3H17M21 3L15 9M18.5 21C9.93959 21 3 14.0604 3 5.5C3 5.11378 3.01413 4.73086 3.04189 4.35173C3.07375 3.91662 3.08968 3.69907 3.2037 3.50103C3.29814 3.33701 3.4655 3.18146 3.63598 3.09925C3.84181 3 4.08188 3 4.56201 3H7.37932C7.78308 3 7.98496 3 8.15802 3.06645C8.31089 3.12515 8.44701 3.22049 8.55442 3.3441C8.67601 3.48403 8.745 3.67376 8.88299 4.05321L10.0491 7.26005C10.2096 7.70153 10.2899 7.92227 10.2763 8.1317C10.2643 8.31637 10.2012 8.49408 10.0942 8.64506C9.97286 8.81628 9.77145 8.93713 9.36863 9.17882L8 10C9.2019 12.6489 11.3501 14.7999 14 16L14.8212 14.6314C15.0629 14.2285 15.1837 14.0271 15.3549 13.9058C15.5059 13.7988 15.6836 13.7357 15.8683 13.7237C16.0777 13.7101 16.2985 13.7904 16.74 13.9509L19.9468 15.117C20.3262 15.255 20.516 15.324 20.6559 15.4456C20.7795 15.553 20.8749 15.6891 20.9335 15.842C21 16.015 21 16.2169 21 16.6207V19.438C21 19.9181 21 20.1582 20.9007 20.364C20.8185 20.5345 20.663 20.7019 20.499 20.7963C20.3009 20.9103 20.0834 20.9262 19.6483 20.9581C19.2691 20.9859 18.8862 21 18.5 21Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                                         </g>
                                   </svg>
                                    <span x-text="slide.btnText"></span>
                                </a>
                            </div>
                        </template>
                           <template x-if="slide.btnText">
                            <div class="sm:pt-2">
                                <a href="/Urun/batarya-paketleri"
                                   class="inline-flex items-center gap-1.5 sm:gap-2.5
                                          px-4 py-2 sm:px-8 sm:py-3.5
                                          bg-transparent hover:opacity-80 text-gray-100
                                          font-bold text-xs sm:text-base
                                          rounded-full shadow-2xl
                                          transition-all duration-300 ease-out
                                         hover:shadow-xl
                                          ring-2 ring-gray-100
                                          whitespace-nowrap">
                                    <span x-text="slide.btnText2"></span>
                                    <!-- Arrow right -->
                                    <svg class="w-4 h-4 sm:w-5 sm:h-5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M5 12h14M13 5l7 7-7 7"/>
                                    </svg>
                                </a>
                            </div>
                        </template>
                    </div>

                        <!-- Brand marquee -->
                        <div class="mt-4 sm:mt-6 overflow-hidden w-full max-w-md">
                            <div class="brand-marquee">
                                <!-- Set 1 -->
                                <div class="marquee-set">
                                    <img src="/img/Aspilsan-Logo.webp" alt="Aspilsan" />
                                    <img src="/img/molicel.webp" alt="Molicel" />
                                    <img src="/img/europlus.webp" alt="Europlus" />
                                    <img src="/img/hdalogo.webp" alt="HDA Power" />
                                    <img src="/img/orion.webp" alt="Orion" />
                                </div>
                                <!-- Set 2 (duplicate for seamless loop) -->
                                <div class="marquee-set">
                                    <img src="/img/Aspilsan-Logo.webp" alt="Aspilsan" />
                                    <img src="/img/molicel.webp" alt="Molicel" />
                                    <img src="/img/europlus.webp" alt="Europlus" />
                                    <img src="/img/hdalogo.webp" alt="HDA Power" />
                                    <img src="/img/orion.webp" alt="Orion" />
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

            </div>
        </template>
         @*
        <!-- Prev/Next (raise above slide) -->
        <button type="button" x-on:click="prev()"
                class="absolute left-3 top-1/2 -translate-y-1/2 rounded-full bg-black/40 p-2
                   hover:bg-black/60 focus:outline-none z-30 cursor-pointer">
            <span class="sr-only">Önceki</span>
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none">
                <path d="M15 19l-7-7 7-7" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </button>
        <button type="button" x-on:click="next()"
                class="absolute right-3 top-1/2 -translate-y-1/2 rounded-full bg-black/40 p-2
                   hover:bg-black/60 focus:outline-none z-30 cursor-pointer">
            <span class="sr-only">Sonraki</span>
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none">
                <path d="M9 5l7 7-7 7" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </button>

        <!-- Dots (raise above slide) -->
        <div class="absolute bottom-3 left-1/2 -translate-x-1/2 flex gap-2 z-30">
            <template x-for="(s, i) in slides" :key="'dot-'+i">
                <button type="button" x-on:click="go(i)"
                        class="h-2.5 w-2.5 rounded-full transition"
                        :class="current===i ? 'bg-white' : 'bg-white/40 hover:bg-white/70'">
                    <span class="sr-only" x-text="'Slayt ' + (i+1)"></span>
                </button>
            </template>
        </div>
        *@
    </div>
</section>


