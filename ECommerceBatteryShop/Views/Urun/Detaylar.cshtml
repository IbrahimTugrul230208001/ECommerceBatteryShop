@using System.Globalization
@using Microsoft.AspNetCore.Html
@model ECommerceBatteryShop.Models.ProductDetailsViewModel
@{
    var productInStock = Model.product.StockQuantity > 0;
    var productStockText = productInStock ? "Stokta var" : "Stokta yok";
    var productStockClass = productInStock ? "text-emerald-600" : "text-rose-600";
}

<main class="bg-white min-h-screen py-30 px-4 lg:px-40">
<div class="mx-auto">

    <!-- Grid: image left, info right -->
    <div x-data="{ qty:1, added:false, inc(){ this.qty++; }, dec(){ if(this.qty>1) this.qty--; }, sanitize(){ this.qty=parseInt(this.qty||1,10); if(this.qty<1) this.qty=1; } }" class="grid grid-cols-1 lg:grid-cols-2 gap-10">

        <!-- Left: Image / gallery -->
        <section class="rounded-2xl border border-slate-200 bg-white p-4 sm:p-6 shadow-sm">
            <div class="relative rounded-xl bg-white overflow-hidden flex items-center justify-center p-8 h-125"
                 x-data="{
                     zooming: false,
                     lensX: 0,
                     lensY: 0,
                     bgPosX: 0,
                     bgPosY: 0,
                     bgW: 0,
                     bgH: 0,
                     lensSize: 180,
                     zoom: 2.5,
                     imgSrc: '/img/@(string.IsNullOrWhiteSpace(Model.product.ImageUrl) ? "temsili.webp" : Model.product.ImageUrl)',
                     onMove(e) {
                         const wrap = this.$refs.zoomWrap;
                         const img  = this.$refs.zoomImg;
                         const wrapRect = wrap.getBoundingClientRect();
                         const imgRect  = img.getBoundingClientRect();

                         // cursor position relative to the wrapper (for lens placement)
                         const cx = e.clientX - wrapRect.left;
                         const cy = e.clientY - wrapRect.top;
                         this.lensX = cx - this.lensSize / 2;
                         this.lensY = cy - this.lensSize / 2;

                         // cursor position relative to the actual rendered image
                         const ix = e.clientX - imgRect.left;
                         const iy = e.clientY - imgRect.top;

                         // zoomed image dimensions
                         this.bgW = imgRect.width  * this.zoom;
                         this.bgH = imgRect.height * this.zoom;

                         // background offset so the cursor point is centered in the lens
                         this.bgPosX = -(ix * this.zoom - this.lensSize / 2);
                         this.bgPosY = -(iy * this.zoom - this.lensSize / 2);

                         this.zooming = true;
                     },
                     onLeave() { this.zooming = false; }
                 }"
                 x-ref="zoomWrap"
                 x-on:mousemove="onMove($event)"
                 x-on:mouseleave="onLeave()"
                 style="cursor: zoom-in;">

                <img :src="imgSrc"
                     x-ref="zoomImg"
                     alt="@(string.IsNullOrWhiteSpace(Model.product.Name) ? "Görsel yok" : Model.product.Name)"
                     class="max-h-full max-w-full object-contain select-none pointer-events-none"/>

                <!-- Zoom lens overlay -->
                <div x-show="zooming"
                     x-transition:enter="transition ease-out duration-150"
                     x-transition:enter-start="opacity-0 scale-90"
                     x-transition:enter-end="opacity-100 scale-100"
                     x-transition:leave="transition ease-in duration-100"
                     x-transition:leave-start="opacity-100 scale-100"
                     x-transition:leave-end="opacity-0 scale-90"
                     class="absolute rounded-full border-2 border-white/70 shadow-xl pointer-events-none z-10"
                     :style="`
                         width: ${lensSize}px;
                         height: ${lensSize}px;
                         left: ${lensX}px;
                         top: ${lensY}px;
                         background-image: url('${imgSrc}');
                         background-repeat: no-repeat;
                         background-size: ${bgW}px ${bgH}px;
                         background-position: ${bgPosX}px ${bgPosY}px;
                         box-shadow: 0 0 0 2px rgba(251,191,36,0.4), 0 8px 32px rgba(0,0,0,0.18);
                     `">
                </div>
            </div>
        </section>


        <!-- Right: Details -->
        <section class="rounded-2xl border border-slate-200 bg-white p-4 sm:p-6 shadow-sm">
            <h1 class="text-2xl font-semibold text-slate-900">@Model.product.Name</h1>
