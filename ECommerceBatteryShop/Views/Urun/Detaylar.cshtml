@using System.Globalization
@using Microsoft.AspNetCore.Html
@model ECommerceBatteryShop.Models.ProductDetailsViewModel
@{
    var productInStock = Model.product.StockQuantity > 0;
    var productStockText = productInStock ? "Stokta var" : "Stokta yok";
    var productStockClass = productInStock ? "text-emerald-600" : "text-rose-600";
    
    var strippedDescription = string.IsNullOrWhiteSpace(Model.product.Description) 
        ? "" 
        : System.Text.RegularExpressions.Regex.Replace(Model.product.Description, "<.*?>", string.Empty)
            .Replace("\"", "\\\"").Replace("\r", "").Replace("\n", " ");
}

<script type="application/ld+json">
{
  "@@context": "https://schema.org/",
  "@@type": "Product",
  "name": "@Html.Raw(Model.product.Name?.Replace("\"", "\\\""))",
  "image": [
    "https://pilbataryamarketim.com/img/@(string.IsNullOrWhiteSpace(Model.product.ImageUrl) ? "temsili.webp" : Model.product.ImageUrl)"
   ],
  "description": "@Html.Raw(strippedDescription)",
  "brand": {
    "@@type": "Brand",
    "name": "Pil Batarya Marketim"
  },
  "offers": {
    "@@type": "Offer",
    "url": "https://pilbataryamarketim.com/@Model.product.Slug",
    "priceCurrency": "TRY",
    "price": "@Model.product.Price.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)",
    "availability": "@(productInStock ? "https://schema.org/InStock" : "https://schema.org/OutOfStock")"
  }
}
</script>

<main class="bg-white min-h-screen py-30 px-4 lg:px-40">
<div class="mx-auto">

    <!-- Grid: image left, info right -->
    <div x-data="{ qty:1, added:false, inc(){ this.qty++; }, dec(){ if(this.qty>1) this.qty--; }, sanitize(){ this.qty=parseInt(this.qty||1,10); if(this.qty<1) this.qty=1; } }" class="flex flex-col lg:flex-row justify-between items-start gap-10">

        <!-- Left: Image / gallery -->
        <section class="relative rounded-md border border-slate-300 bg-white p-4 sm:p-6 w-full lg:w-2xl"
                 x-data="{
                     zooming: false,
                     lensW: 0, lensH: 0, lensX: 0, lensY: 0,
                     bgPosX: 0, bgPosY: 0, bgW: 0, bgH: 0,
                     zoom: 2.5,
                     imgSrc: '/img/@(string.IsNullOrWhiteSpace(Model.product.ImageUrl) ? "temsili.webp" : Model.product.ImageUrl)',
                     onMove(e) {
                         const wrap = this.$refs.zoomWrap;
                         const img = this.$refs.zoomImg;
                         const container = this.$refs.container;
                         if (!wrap || !img || !container) return;

                         const imgRect = img.getBoundingClientRect();
                         const wrapRect = wrap.getBoundingClientRect();
                         const containerRect = container.getBoundingClientRect();
                         
                         const cx = e.clientX - imgRect.left;
                         const cy = e.clientY - imgRect.top;

                         if (cx < 0 || cy < 0 || cx > imgRect.width || cy > imgRect.height) {
                             this.zooming = false;
                             return;
                         }

                         this.lensW = containerRect.width / this.zoom;
                         this.lensH = containerRect.height / this.zoom;

                         let lx = cx - (this.lensW / 2);
                         let ly = cy - (this.lensH / 2);

                         if (lx < 0) lx = 0;
                         if (ly < 0) ly = 0;
                         if (lx > imgRect.width - this.lensW) lx = imgRect.width - this.lensW;
                         if (ly > imgRect.height - this.lensH) ly = imgRect.height - this.lensH;

                         // relative to wrap (the inner div that holds the lens)
                         this.lensX = (imgRect.left - wrapRect.left) + lx;
                         this.lensY = (imgRect.top - wrapRect.top) + ly;

                         this.bgW = imgRect.width * this.zoom;
                         this.bgH = imgRect.height * this.zoom;

                         this.bgPosX = -(lx * this.zoom);
                         this.bgPosY = -(ly * this.zoom);

                         this.zooming = true;
                     }
                 }"
                 x-ref="container">
            
            <div class="relative rounded-xl bg-white flex items-center justify-center p-4 h-125"
                 x-ref="zoomWrap"
                 x-on:mousemove="onMove($event)"
                 x-on:mouseleave="zooming = false"
                 style="cursor: zoom-in;">

                <img asp-append-version="true" :src="imgSrc"
                     x-ref="zoomImg"
                     alt="@(string.IsNullOrWhiteSpace(Model.product.Name) ? "Görsel yok" : Model.product.Name)"
                     class="max-h-full w-full object-contain select-none pointer-events-none"/>

                <!-- Lens Overlay -->
                <div x-show="zooming"
                     class="absolute bg-white/10 border border-slate-600 pointer-events-none z-10 hidden lg:block"
                     :style="`width: ${lensW}px; height: ${lensH}px; left: ${lensX}px; top: ${lensY}px;`">
                </div>
            </div>

            <!-- External Zoom Box (Appears to the right) -->
            <div x-show="zooming"
                 class="absolute top-0 z-50 bg-white border border-slate-200 shadow-2xl rounded-2xl hidden lg:block"
                 :style="`
                     left: calc(100% + 2.5rem);
                     width: 100%;
                     height: 100%;
                     background-image: url('${imgSrc}');
                     background-repeat: no-repeat;
                     background-size: ${bgW}px ${bgH}px;
                     background-position: ${bgPosX}px ${bgPosY}px;
                 `">
            </div>
        </section>


