<!-- Alpine v3 -->
<div x-data="{
        tab: 'desc',
        set(t){ this.tab=t; history.replaceState(null,'',`#${t}`) },
        init(){ const h=location.hash.replace('#',''); if(['desc','files','reviews','qna','hepsifinans','kredi','iade'].includes(h)) this.tab=h; }
     }"
     class="mt-10 mx-auto">

    <div class="border border-slate-300 rounded-md bg-white">
        <!-- Tabs Header -->
        <div role="tablist" aria-label="Ürün sekmeleri" class="flex flex-nowrap overflow-x-auto border-b border-slate-300 hide-scrollbar">
            <button role="tab" x-on:click="set('desc')" :aria-selected="tab==='desc'"
                    class="relative px-6 py-4 text-sm font-semibold transition-colors whitespace-nowrap cursor-pointer"
                    :class="tab==='desc' ? 'text-slate-900' : 'text-slate-500 hover:text-slate-700'">
                Ürün Açıklaması
                <div x-show="tab==='desc'" class="absolute bottom-0 left-0 w-full h-0.5 bg-orange-500"></div>
            </button>
            
            <button role="tab" x-on:click="set('iade')" :aria-selected="tab==='iade'"
                    class="relative px-6 py-4 text-sm font-semibold transition-colors whitespace-nowrap cursor-pointer"
                    :class="tab==='iade' ? 'text-slate-900' : 'text-slate-500 hover:text-slate-700'">
                İptal ve İade Koşulları
                <div x-show="tab==='iade'" class="absolute bottom-0 left-0 w-full h-0.5 bg-orange-500"></div>
            </button>

            <button role="tab" x-on:click="set('files')" :aria-selected="tab==='files'"
                    class="relative px-6 py-4 text-sm font-semibold transition-colors whitespace-nowrap cursor-pointer"
                    :class="tab==='files' ? 'text-slate-900' : 'text-slate-500 hover:text-slate-700'">
                Dosya Eki
                <div x-show="tab==='files'" class="absolute bottom-0 left-0 w-full h-0.5 bg-orange-500"></div>
            </button>
        </div>

        <!-- Panels -->
        <div class="p-6 sm:p-8">
            <!-- DESC -->
            <section x-show="tab==='desc'" x-cloak role="tabpanel" :aria-hidden="tab!=='desc'">
                <h2 class="text-xl font-semibold text-slate-900 mb-4">Teknik Özellikler</h2>
            @if (!string.IsNullOrWhiteSpace(Model.product.Description))
            {
                @functions {

                    string Escape(string s) =>
                        s.Replace("&", "&amp;").Replace("<", "&lt;").Replace(">", "&gt;").Replace("\"", "&quot;").Replace("'", "&#39;");

                    IHtmlContent Bullets(string text)
                    {
                        var normalized = (text ?? "").Replace("\r\n", "\n");
                        var paragraphs = System.Text.RegularExpressions.Regex.Split(normalized, @"\n{2,}")
                            .Select(p => p.Trim()).ToList();

                        var result = new System.Text.StringBuilder();
                        foreach (var para in paragraphs)
                        {
                            if (string.IsNullOrEmpty(para))
                            {
                                result.Append("<br/>");
                                continue;
                            }

                            var lines = para.Split('\n').Select(s => s.Trim()).Where(s => s.Length > 0).ToList();

                            // Check if lines contain ":" separator – render as spec table
                            var colonLines = lines.Where(l => l.Contains(':')).ToList();
                            var nonColonLines = lines.Where(l => !l.Contains(':')).ToList();

                            // Render non-colon lines normally
                            foreach (var line in nonColonLines)
                            {
                                result.Append($"<p>{Escape(line)}</p>");
                            }

                            // Render colon lines as a striped table
                            if (colonLines.Count > 0)
                            {
                                result.Append("<div style=\"border:1px solid #e2e8f0; border-radius:0.75rem; overflow:hidden; box-shadow:0 1px 2px rgba(0,0,0,0.05)\">");
                                result.Append("<table style=\"width:100%; border-collapse:collapse; font-size:0.875rem\">");
                                result.Append("<tbody>");
                                int rowIndex = 0;
                                foreach (var line in colonLines)
                                {
                                    var colonIdx = line.IndexOf(':');
                                    var label = line.Substring(0, colonIdx).Trim();
                                    var value = line.Substring(colonIdx + 1).Trim();
                                    var bgColor = "#ffffff";
                                    var borderTop = rowIndex > 0 ? "border-top:1px solid #e2e8f0;" : "";
                                    result.Append("<tr>");
                                    result.Append($"<td style=\"padding:0.75rem 1rem; font-weight:600; color:#334155; white-space:nowrap; border-right:1px solid #e2e8f0; width:33%; background-color:{bgColor}; {borderTop}\">{Escape(label)}</td>");
                                    result.Append($"<td style=\"padding:0.75rem 1rem; color:#475569; background-color:{bgColor}; {borderTop}\">{Escape(value)}</td>");
                                    result.Append("</tr>");
                                    rowIndex++;
                                }

                                result.Append("</tbody>");
                                result.Append("</table>");
                                result.Append("</div>");
                            }
                        }

                        return new HtmlString(result.ToString());
                    }

                }
                    <div class="max-w-none text-slate-700 leading-relaxed">
                    @Bullets(Model.product.Description)
                </div>
            }
            else
            {
                <div class="rounded-xl border border-dashed border-slate-300 p-6 text-center text-slate-500">
                    Bu ürün için açıklama eklenmemiştir.
                </div>
            }
        </section>

        <!-- FILES -->
        <section x-show="tab==='files'" x-cloak role="tabpanel" :aria-hidden="tab!=='files'">
            <h2 class="text-xl font-semibold text-slate-900 mb-4">Dosya Eki</h2>
            @if (Model.product.AttachmentUrl != null)
            {
                <ul class="space-y-3">
                    <li class="flex items-center justify-between rounded-lg border border-slate-200 p-4">
                        <div>
                            <div class="text-slate-500 text-sm">PDF / Doküman</div>
                        </div>
                        <a href="/doc/@Model.product.AttachmentUrl" target="_blank" rel="noopener"
                           class="inline-flex items-center rounded-lg border border-slate-300 px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">
                            PDF’i Aç
                        </a>
                    </li>
                </ul>
            }
            else
            {
                <div class="rounded-xl border border-dashed border-slate-300 p-6 text-center text-slate-500">
                    Bu ürün için dosya eki yok.
                </div>
            }
        </section>

        <!-- IPTAL IADE -->
        <section x-show="tab==='iade'" x-cloak role="tabpanel" :aria-hidden="tab!=='iade'">
            <div class="rounded-xl border border-dashed border-slate-300 p-6 text-center text-slate-500">
                İptal ve iade koşulları bilgileri burada yer alacak.
            </div>
        </section>
    </div>
</div>

<section class="space-y-6 my-12">
    <div class="flex items-center justify-between">
        <h2 class="text-2xl font-bold text-gray-900">İlginizi Çekebilecek Ürünler</h2>

        <a href="/Urun/Index"
           class="group inline-flex items-center gap-1.5 text-sm font-semibold text-gray-800 hover:text-amber-500">
            Tüm Ürünler
            <svg class="h-4 w-4 transition-transform group-hover:translate-x-0.5"
                 viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M5 12h14M13 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </a>
    </div>

    <div x-data="{
             atStart: true, atEnd: false,
             onScroll(){ const el=$refs.scroller; this.atStart=el.scrollLeft<=5; this.atEnd = el.scrollLeft+el.clientWidth>=el.scrollWidth-5; },
               next(){ const el=$refs.scroller; el.scrollBy({left: el.clientWidth, behavior:'smooth'}); },
               prev(){ const el=$refs.scroller; el.scrollBy({left: -el.clientWidth, behavior:'smooth'}); }
             }"
         x-init="onScroll()"
         class="relative">

        <!-- Controls -->
        <button type="button" x-on:click="prev" :class="{'opacity-40 pointer-events-none': atStart}"
                class="absolute left-2 top-1/2 hover:bg-amber-400 hover:text-white cursor-pointer -translate-y-1/2 z-10 h-10 w-10 grid place-items-center border border-slate-300 rounded-full bg-white shadow-xl"
                aria-label="Önceki">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" transform="rotate(180)">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M8.29289 4.29289C8.68342 3.90237 9.31658 3.90237 9.70711 4.29289L16.7071 11.2929C17.0976 11.6834 17.0976 12.3166 16.7071 12.7071L9.70711 19.7071C9.31658 20.0976 8.68342 20.0976 8.29289 19.7071C7.90237 19.3166 7.90237 18.6834 8.29289 18.2929L14.5858 12L8.29289 5.70711C7.90237 5.31658 7.90237 4.68342 8.29289 4.29289Z" fill="currentColor"/>
            </svg>
        </button>

        <button type="button" x-on:click="next" :class="{'opacity-40 pointer-events-none': atEnd}"
                class="absolute right-2 top-1/2 -translate-y-1/2 z-10 h-10 w-10 hover:text-white grid place-items-center text-xl rounded-full bg-white shadow-xl border border-slate-300 hover:bg-amber-400 cursor-pointer"
                aria-label="Sonraki">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M8.29289 4.29289C8.68342 3.90237 9.31658 3.90237 9.70711 4.29289L16.7071 11.2929C17.0976 11.6834 17.0976 12.3166 16.7071 12.7071L9.70711 19.7071C9.31658 20.0976 8.68342 20.0976 8.29289 19.7071C7.90237 19.3166 7.90237 18.6834 8.29289 18.2929L14.5858 12L8.29289 5.70711C7.90237 5.31658 7.90237 4.68342 8.29289 4.29289Z" fill="currentColor"/>
            </svg>
        </button>

        <!-- Track -->
        <div x-ref="scroller" style="--g:12px" @@scroll.passive="onScroll"
             class="flex gap-[var(--g)] overflow-x-auto snap-x snap-mandatory scroll-smooth hide-scrollbar px-1 py-2">

            @foreach (var product in Model.RelatedProducts)
            {
                <div class="flex-none min-w-0 pl-2 lg:basis-[calc((100%-4*var(--g))/6)] md:basis-[calc((100%-2*var(--g))/4)] basis-[calc((100%-1*var(--g))/2)] snap-start">
                    @await Html.PartialAsync("~/Views/Components/_ProductCard.cshtml", product)
                </div>
            }
        </div>
    </div>
</section>


</main>
<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('carousel', ({ visible = 4 } = {}) => ({
            i: 0, visible, maxIndex: 0,
            init() {
                this.$nextTick(() => {
                    const track = this.$refs.track;
                    const items = track.querySelectorAll('[data-item]');
                    const gap = parseFloat(getComputedStyle(track).gap || 16);
                    this.itemWidth = items[0]?.offsetWidth + gap || 0;
                    this.count = items.length;
                    this.maxIndex = Math.max(0, this.count - this.visible);
                });
            },
            move(dir) {
                this.i = Math.max(0, Math.min(this.i + dir, this.maxIndex));
                this.$refs.track.scrollTo({ left: this.i * this.itemWidth, behavior: 'smooth' });
            }
        }));
    });
</script>
