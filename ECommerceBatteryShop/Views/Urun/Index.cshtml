@model ECommerceBatteryShop.Models.ProductIndexViewModel
@using System.Globalization
@inject ECommerceBatteryShop.Services.ICategoryService CategoryService

@{
    var categoriesByService = await CategoryService.GetCategoryTreeAsync();

    ECommerceBatteryShop.DataAccess.Entities.Category?
    FindCategory(IEnumerable<ECommerceBatteryShop.DataAccess.Entities.Category> nodes, int id)
    {
        foreach (var node in nodes)
        {
            if (node.Id == id) return node;
            if (node.SubCategories != null && node.SubCategories.Any())
            {
                var found = FindCategory(node.SubCategories, id);
                if (found != null) return found;
            }
        }
        return null;
    }

    var products = Model?.Products ?? Array.Empty<ECommerceBatteryShop.Models.ProductViewModel>();

    var hasResults = products.Any();

    if (!hasResults)
    {
        ViewData["NoFooterMobileSpace"] = true;
    }
    var minQ = (ViewBag.MinPrice as decimal?)?.ToString("0.##") ?? string.Empty;
    var maxQ = (ViewBag.MaxPrice as decimal?)?.ToString("0.##") ?? string.Empty;
    var hasFilter = (bool)(ViewBag.HasFilter ?? false);
    var currentPage = Model?.CurrentPage ?? 1;
    var totalPages = Math.Max(1, Model?.TotalPages ?? 1);
    var pageSize = Model?.PageSize ?? 30;
    var totalCount = Model?.TotalCount ?? 0;
    var showingFrom = totalCount == 0 ? 0 : (currentPage - 1) * pageSize + 1;
    var showingTo = totalCount == 0 ? 0 : Math.Min(currentPage * pageSize, totalCount);
    var searchTerm = ViewBag.SearchTerm as string ?? string.Empty;
    int? currentCategoryId = ViewBag.CategoryId is int cid ? cid : ViewBag.CategoryId as int?;
    var minParam = ViewBag.MinPrice is decimal minVal ? minVal.ToString(CultureInfo.InvariantCulture) : null;
    var maxParam = ViewBag.MaxPrice is decimal maxVal ? maxVal.ToString(CultureInfo.InvariantCulture) : null;
    var sortParam = ViewBag.Sort as string;
    var hasSearch = !string.IsNullOrWhiteSpace(searchTerm);

    var activeCategory = currentCategoryId.HasValue ? FindCategory(categoriesByService, currentCategoryId.Value) : null;
    var subCategories = activeCategory?.SubCategories?.ToList() ?? new
    List<ECommerceBatteryShop.DataAccess.Entities.Category>();

    // Build set of ancestor IDs so we can auto-expand & highlight the active path
    var activePath = new HashSet<int>();
    ECommerceBatteryShop.DataAccess.Entities.Category? rootCategory = null;
    var breadcrumbCategories = new List<ECommerceBatteryShop.DataAccess.Entities.Category>();
    if (activeCategory != null)
    {
        activePath.Add(activeCategory.Id);
        // Walk up ancestors via Path
        var segments = activeCategory.Path.Split('/');
        var pathSoFar = "";
        foreach (var seg in segments)
        {
            pathSoFar = string.IsNullOrEmpty(pathSoFar) ? seg : pathSoFar + "/" + seg;
            var ancestor = FindCategoryByPredicate(categoriesByService, c => c.Path == pathSoFar);
            if (ancestor != null)
            {
                activePath.Add(ancestor.Id);
                breadcrumbCategories.Add(ancestor);
            }
        }
        // Root ancestor = first path segment
        var rootPath = segments[0];
        rootCategory = FindCategoryByPredicate(categoriesByService, c => c.Path == rootPath);
    }
    var showSidebar = rootCategory != null;

    ECommerceBatteryShop.DataAccess.Entities.Category?
    FindCategoryByPredicate(IEnumerable<ECommerceBatteryShop.DataAccess.Entities.Category> nodes, Func<ECommerceBatteryShop.DataAccess.Entities.Category, bool> predicate)
    {
        foreach (var node in nodes)
        {
            if (predicate(node)) return node;
            if (node.SubCategories != null && node.SubCategories.Any())
            {
                var found = FindCategoryByPredicate(node.SubCategories, predicate);
                if (found != null) return found;
            }
        }
        return null;
    }

    Func<int, object> pageRoute = targetPage => new
    {
        page = targetPage,
        search = hasSearch ? searchTerm : null,
        q = hasSearch ? searchTerm : null,
        categoryId = currentCategoryId,
        minPrice = minParam,
        maxPrice = maxParam,
        sort = sortParam
    };
}

<!-- Include once globally (Layout). Safe if duplicated -->
<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>



@if (!hasResults)
{
    <!-- EMPTY STATE -->
    <div class="mx-auto max-w-screen-md mb-10">
    <div class="mt-10 rounded-2xl border border-slate-200 bg-white p-10 text-center shadow-sm">
        <div class="mx-auto mb-4 grid h-16 w-16 place-items-center rounded-full ring-1 ring-slate-200">
            <svg class="h-8 w-8 text-slate-500" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                stroke-width="1.6">
                <rect x="3" y="7" width="18" height="10" rx="2"></rect>
                <rect x="21" y="10" width="1.5" height="4" rx="0.5" fill="currentColor" stroke="none"></rect>
                <path d="M7 10h6M7 13h4" />
            </svg>
        </div>

        <h2 class="text-xl font-semibold">Sonuç bulunamadı</h2>
        <p class="mt-1 text-sm text-slate-600">
            Aramanız için eşleşen ürün yok. Yazımı kontrol edin ya da filtreleri gevşetin.
        </p>

        <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
            @if (hasFilter)
                {
                    <a href="/Urun/Index"
                        class="inline-flex items-center gap-2 rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-medium hover:bg-slate-50">
                        Filtreleri temizle
                    </a>
                }
                <a href="/Urun/Index"
                    class="inline-flex items-center gap-2 rounded-lg bg-amber-300 px-4 py-2 text-sm font-semibold text-gray-900 shadow hover:bg-amber-400">
                    Tüm ürünlere dön
                </a>
            </div>
        </div>
    </div>
}
else
{

    <div class="max-w-[95rem] mx-auto py-6 flex flex-col gap-4 md:flex-row md:items-center md:justify-between px-4">
    <h1 class="text-3xl font-bold mb-0">
        @if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
            {
                @:"@Model.SearchQuery" için arama sonuçları
            }
            else if (!string.IsNullOrWhiteSpace(Model.CategoryFilter))
            {
                @Model.CategoryFilter
            }
            else
            {
                @:Tüm Ürünler
            }
        </h1>

        <form method="get"
            class="w-full md:w-auto md:mb-0 flex items-center justify-between gap-4 px-2 md:px-0">
            @if (hasSearch)
            {
                <input type="hidden" name="search" value="@searchTerm" />
                <input type="hidden" name="q" value="@searchTerm" />
            }
            @if (currentCategoryId.HasValue)
            {
                <input type="hidden" name="categoryId" value="@currentCategoryId" />
            }

            @if (totalCount > 0)
            {
                <div class="text-sm text-slate-600 whitespace-nowrap">
                    @if (showingFrom == showingTo)
                    {
                        <span>@showingFrom.</span>
                    }
                    else
                    {
                        <span>@showingFrom-@showingTo.</span>
                    }
                    <span> ürün gösteriliyor · Toplam @totalCount ürün</span>
                </div>
            }

            <div class="relative" x-data="{ open: false }">
                <button type="button" @@click="open = !open"
                    class="flex items-center gap-2 px-4 py-2 rounded-xl bg-amber-400 text-gray-900 font-semibold shadow hover:bg-amber-400 transition cursor-pointer">
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
                    </svg>
                    Sırala
                </button>
                <div x-show="open" @@click.away="open = false" x-cloak style="display: none;"
                    class="absolute right-0 mt-2 w-48 rounded-md shadow-lg bg-white ring-1 ring-black ring-opacity-5 z-20 overflow-hidden">
                    <button type="submit" name="sort" value="asc"
                        class="block w-full text-left px-4 py-3 text-sm text-gray-700 hover:bg-slate-50 border-b border-gray-100">
                        Yükselen fiyat
                    </button>
                    <button type="submit" name="sort" value="desc"
                        class="block w-full text-left px-4 py-3 text-sm text-gray-700 hover:bg-slate-50">
                        Azalan fiyat
                    </button>
                </div>
            </div>
        </form>
    </div>

    @if (breadcrumbCategories.Any())
    {
        <nav aria-label="Breadcrumb" class="max-w-[95rem] mx-auto px-4 mt-2">
            <ol class="flex items-center flex-wrap gap-1.5 text-sm text-gray-500">
                <li class="flex items-center gap-1.5">
                    <a href="/" class="hover:text-amber-600 transition-colors">Anasayfa</a>
                    <svg class="w-3.5 h-3.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                </li>
                @for (var i = 0; i < breadcrumbCategories.Count; i++)
                {
                    var bc = breadcrumbCategories[i];
                    var isLast = i == breadcrumbCategories.Count - 1;
                    <li class="flex items-center gap-1.5">
                        @if (isLast)
                        {
                            <span class="font-semibold text-amber-700">@bc.Name</span>
                        }
                        else
                        {
                            <a href="/Urun/@bc.Slug" class="hover:text-amber-600 transition-colors">@bc.Name</a>
                            <svg class="w-3.5 h-3.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                            </svg>
                        }
                    </li>
                }
            </ol>
        </nav>
    }



    <!-- PRODUCT GRID -->
    <div class="max-w-[95rem] mx-auto flex flex-col md:flex-row gap-6 mb-20 px-4 mt-10">

        @if (showSidebar)
        {
            <!-- ── Category Tree Sidebar ── -->
            <aside class="shrink-0 hidden md:block w-1xl">
                <div class="bg-white rounded-2xl shadow-sm border border-slate-200/80 sticky top-24 overflow-hidden">
                    <!-- Sidebar Header -->
                    <div class="px-5 py-4 bg-gradient-to-r from-amber-50 to-amber-100/50 border-b border-amber-200/60">
                        <h3 class="font-bold text-base text-gray-900 flex items-center gap-2">
                            <svg class="w-5 h-5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" />
                            </svg>
                            @rootCategory!.Name
                        </h3>
                    </div>

                    <!-- Tree -->
                    <nav class="p-3 max-h-[calc(100vh-10rem)] overflow-y-auto">
                        @{ void RenderCategoryTree(IEnumerable<ECommerceBatteryShop.DataAccess.Entities.Category> categories, int depth = 0)
                        {
                            foreach (var cat in categories)
                            {
                                var hasChildren = cat.SubCategories != null && cat.SubCategories.Any();
                                var isActive = currentCategoryId.HasValue && cat.Id == currentCategoryId.Value;
                                var isInPath = activePath.Contains(cat.Id) && !isActive;
                                var shouldExpand = activePath.Contains(cat.Id);

                                <div x-data="{ open: @(shouldExpand ? "true" : "false") }">
                                    <div class="flex items-center gap-1 group rounded-lg cat-tree-item @(isActive ? "active" : "") @(isInPath ? "bg-amber-50/60" : "")">
                                        @if (hasChildren)
                                        {
                                            <button @@click="open = !open" type="button"
                                                class="p-1.5 rounded-md hover:bg-gray-400 transition-colors shrink-0 cursor-pointer">
                                                <svg class="w-3.5 h-3.5 text-gray-500 cat-tree-toggle transition-transform duration-200"
                                                     :class="open && 'open'"
                                                     fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
                                                </svg>
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="w-7 shrink-0"></span>
                                        }
                                        <a href="/Urun/@cat.Slug"
                                           class="flex-1 py-2 text-sm @(isActive ? "text-amber-800 font-semibold" : isInPath ? "text-amber-700 font-medium" : "text-gray-700") transition-colors truncate">
                                            @cat.Name
                                        </a>
                                        @if (isActive)
                                        {
                                            <span class="w-1.5 h-1.5 rounded-full bg-amber-500 mr-2 shrink-0"></span>
                                        }
                                    </div>

                                    @if (hasChildren)
                                    {
                                        <div x-show="open" x-collapse>
                                            <div class="border-l-2 border-slate-100" style="margin-left: @(depth * 1.0 + 1.0)rem;">
                                                @{ RenderCategoryTree(cat.SubCategories!, depth + 1); }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        }
                        RenderCategoryTree(rootCategory!.SubCategories); }
                    </nav>
                </div>
            </aside>
        }

        <div class="flex-1 min-w-0">
            <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-@(showSidebar ? "3" : "4") xl:grid-cols-4 gap-4">
                @foreach (var product in products)
                {
                    @await Html.PartialAsync("~/Views/Components/_ProductCard.cshtml", product)
                }
            </div>
        </div>
    </div>

    @if (totalPages > 1)
    {
        var prevDisabled = currentPage <= 1;
        var nextDisabled = currentPage >= totalPages;
        var maxPageButtons = 5;
        var startPage = Math.Max(1, currentPage - 2);
        var endPage = Math.Min(totalPages, startPage + maxPageButtons - 1);
        if (endPage - startPage < maxPageButtons - 1)
        {
            startPage = Math.Max(1, endPage - maxPageButtons + 1);
        }

        <nav class="mt-10 flex flex-col items-center gap-3" aria-label="Sayfalama">
    <div class="text-sm text-slate-600">
        @if (showingFrom == showingTo)
                {
                    <span>@showingFrom.</span>
                }
                else
                {
                    <span>@showingFrom-@showingTo.</span>
                }
                <span> ürün listeleniyor · @totalPages sayfa</span>
            </div>
            <div class="flex flex-wrap items-center justify-center gap-2">
                @if (prevDisabled)
                {
                    <span class="px-3 py-2 text-sm text-slate-400 border border-slate-200 rounded-lg cursor-default">Önceki</span>
                }
                else
                {
                    var prevUrl = Url.Action("Index", "Urun", pageRoute(currentPage - 1));
                    <a href="@prevUrl"
                        class="px-3 py-2 text-sm rounded-lg border border-slate-300 bg-white text-slate-700 hover:bg-slate-50">Önceki</a>
                }

                @if (startPage > 1)
                {
                    var firstUrl = Url.Action("Index", "Urun", pageRoute(1));
                    <a href="@firstUrl"
                        class="px-3 py-2 text-sm rounded-lg border border-slate-300 bg-white text-slate-700 hover:bg-slate-50">1</a>
                    if (startPage > 2)
                    {
                        <span class="px-2 text-slate-400">…</span>
                    }
                }

                @for (var i = startPage; i <= endPage; i++)
                {
                    if (i == currentPage)
                    {
                        <span class="px-3 py-2 text-sm font-semibold rounded-lg bg-amber-300 text-gray-900 shadow">@i</span>
                    }
                    else
                    {
                        var pageUrl = Url.Action("Index", "Urun", pageRoute(i));
                        <a href="@pageUrl"
                            class="px-3 py-2 text-sm rounded-lg border border-slate-300 bg-white text-slate-700 hover:bg-slate-50">@i</a>
                    }
                }

                @if (endPage < totalPages)
                {
                    if (endPage < totalPages - 1)
                    {
                        <span class="px-2 text-slate-400">…</span>
                    }
                    var lastUrl = Url.Action("Index", "Urun", pageRoute(totalPages));
                    <a href="@lastUrl"
                        class="px-3 py-2 text-sm rounded-lg border border-slate-300 bg-white text-slate-700 hover:bg-slate-50">@totalPages</a>
                }

                @if (nextDisabled)
                {
                    <span class="px-3 py-2 text-sm text-slate-400 border border-slate-200 rounded-lg cursor-default">Sonraki</span>
                }
                else
                {
                    var nextUrl = Url.Action("Index", "Urun", pageRoute(currentPage + 1));
                    <a href="@nextUrl"
                        class="px-3 py-2 text-sm rounded-lg border border-slate-300 bg-white text-slate-700 hover:bg-slate-50">Sonraki</a>
                }
            </div>
        </nav>
    }
}

<style>
    input[type=number]::-webkit-inner-spin-button,
    input[type=number]::-webkit-outer-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    input[type=number] {
        -moz-appearance: textfield;
    }
</style>
